{
  "name": "gymgogo-growth-lab-quiz-service",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_AI_ENABLED": "true",
    "AI_PROVIDER": "bailian",
    "AI_MODEL": "qwen-flash",
    "AI_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUIZ_BUDGET",
        "class_name": "QuizBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QuizBudget"
      ]
    }
  ]
}
