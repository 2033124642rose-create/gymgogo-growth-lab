{
  "name": "gymgogo-growth-lab",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-30",
  "vars": {
    "PUBLIC_AI_ENABLED": "true"
  },
  "env": {
    "preview": {
      "vars": {
        "PUBLIC_AI_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "ANALYTICS_DB",
          "database_name": "gymgogo-growth-lab",
          "database_id": "d39c6160-48ec-417c-b179-ed1f649e8af3",
          "migrations_dir": "migrations"
        }
      ],
      "services": [
        {
          "binding": "QUIZ_SERVICE",
          "service": "gymgogo-growth-lab-quiz-service"
        }
      ]
    }
  },
  "d1_databases": [
    {
